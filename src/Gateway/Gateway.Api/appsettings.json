{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp.ReverseProxy": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "user-events": {
        "Order": 1,
        "ClusterId": "commission",
        "Match": { "Path": "/api/users/{externalId}/events" }
      },
      "users": {
        "Order": 2,
        "ClusterId": "partners",
        "Match": { "Path": "/api/users/{**rest}" }
      },
      "users-root": {
        "Order": 2,
        "ClusterId": "partners",
        "Match": { "Path": "/api/users" }
      },
      "events": {
        "Order": 2,
        "ClusterId": "commission",
        "Match": { "Path": "/api/events/{**rest}" }
      },
      "events-root": {
        "Order": 2,
        "ClusterId": "commission",
        "Match": { "Path": "/api/events" }
      },
      "admin-schema": {
        "Order": 2,
        "ClusterId": "commission",
        "Match": { "Path": "/api/admin/schema" }
      },
      "admin-payouts": {
        "Order": 2,
        "ClusterId": "wallet",
        "Match": { "Path": "/api/admin/payouts/{**rest}" }
      },
      "wallets": {
        "Order": 2,
        "ClusterId": "wallet",
        "Match": { "Path": "/api/wallets/{**rest}" }
      }
    },
    "Clusters": {
      "partners": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "commission": { "Destinations": { "d1": { "Address": "http://localhost:5201" } } },
      "wallet": { "Destinations": { "d1": { "Address": "http://localhost:5301" } } }
    }
  }
}
